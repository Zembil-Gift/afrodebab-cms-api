# Copy to .env. Only APP_JWT_SECRET is required; everything else switches on an optional feature.
# DB_* are set by docker-compose.yml, no need to fill them here.

# Required: any long random string (e.g. `openssl rand -base64 48`)
APP_JWT_SECRET=
APP_JWT_EXPIRESMINUTES=120

# Attendance clock-in from the mobile/kiosk client
APP_ATTENDANCE_CLIENT_KEY=

# AI overview of applicant resumes (Google Gemini)
GEMINI_API_KEY=

# Cloudflare R2 file uploads (photos, logos, resumes)
S3_API=
PUBLIC_DEVELOPMENT_URL=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=

# Outgoing email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# Encrypts Trello/GitHub/Google tokens at rest (any long random string)
TOKEN_ENCRYPTION_KEY=

# Integrations (manager "Connect" buttons)
TRELLO_API=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Zoom OAuth app (user-managed). Redirect URL: {FRONTEND_URL}/manager/integrations/zoom
# Scopes: meeting:write:meeting, meeting:update:meeting, meeting:delete:meeting, user:read:user
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Public site origin, used in email and calendar links
FRONTEND_URL=http://localhost:3000
